# 5gpn installer environment
#
# This file contains installation-owned host coordinates only. The live DNS
# policy, upstream groups, subscriptions, cache state, and tuning are fields of
# /etc/5gpn/mihomo/5gpn/dns.json and are managed through the authenticated
# Console. Mihomo cannot read this root-only file.

# Client DNS ingress. DoT :853 is the only public DNS listener; the debug
# listener must remain loopback-only. The loopback origin resolver is fixed at
# 127.0.0.1:5354 inside dns.json and is not an installer knob.
DNS_LISTEN_DOT=:853
DNS_LISTEN_DEBUG=127.0.0.1:5353

# One operator-selected base domain derives console.<base> and dot.<base>.
DNS_BASE_DOMAIN=example.com

# DNS_PUBLIC_IP is the public/NAT identity used for certificate prerequisites.
# DNS_GATEWAY_IP is the IPv4 address returned by gateway DNS decisions.
DNS_PUBLIC_IP=203.0.113.10
DNS_GATEWAY_IP=203.0.113.10

# Comma-separated IPv4 addresses assigned to this host. Mihomo binds its public
# tunnel listeners to these addresses. Loopback and unassigned addresses are
# refused.
DNS_MIHOMO_LISTEN_IPS=203.0.113.10

# Exactly cloudflare, http-01, or debug. Production modes use one scoped
# <base> Certbot lineage. debug uses /etc/5gpn/debug-cert and never writes below
# /etc/letsencrypt.
CERT_MODE=cloudflare
CERT_EMAIL=admin@example.com

# Current public certificate roles. DoT uses the dot role from dns.json; the
# controller and public /ui/* bundle use the console role below. A legacy web
# role may be retained as validated migration evidence but is never refreshed.
DNS_CONSOLE_CERT=/etc/5gpn/cert/console/current/fullchain.pem
DNS_CONSOLE_KEY=/etc/5gpn/cert/console/current/privkey.pem

# Mihomo's loopback TLS controller and its only credential. The installer reads
# the controller location and secret back from the complete operator-owned
# config.yaml so dns.env cannot drift from the process it manages.
DNS_MIHOMO_CONTROLLER=127.0.0.1:443
DNS_MIHOMO_SECRET=

# Retired keys are deliberately absent. The installer accepts known retired
# keys only long enough to rewrite an older dns.env into this current schema.
# In particular there is no standalone DNS API, web certificate role, sidecar
# config, external resolver-state file, profile directory, or heartbeat knob.
