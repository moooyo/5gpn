# 5gpn-unit-id: 5gpn-mihomo.service:v2
[Unit]
Description=5gpn (DNS engine, interception engine, forwarding data plane, control API)
After=network-online.target 5gpn-intercept-cert.path
Wants=network-online.target 5gpn-intercept-cert.path
StartLimitIntervalSec=60
StartLimitBurst=10
StartLimitAction=none

[Service]
Type=simple
ExecStart=/opt/5gpn/bin/5gpn-mihomo -f /etc/5gpn/mihomo/config.yaml -d /etc/5gpn/mihomo
# mihomo is the complete gateway runtime. Any unexpected exit, including a
# clean return after a fatal listener ends, must replace the whole process from
# its atomically persisted state. A deliberate `systemctl stop` is not restarted
# by systemd even with Restart=always.
Restart=always
RestartSec=3
OOMPolicy=continue
KillMode=control-group
User=fivegpn
Group=fivegpn
UMask=0027

# mihomo is the sole long-running process. Each extension validation or action
# executes in a short-lived, same-binary worker below this unit's delegated
# controller subtree. OOMPolicy=continue contains a worker OOM to that operation;
# KillMode=control-group still removes every worker when the unit is stopped.
# These workers are not services or independently supervised sidecars.
#
# systemd starts the trusted parent alone in the private delegated unit root.
# Before opening a listener, the parent creates or validates an empty /main,
# moves itself there, proves the root is empty, enables memory+pids, and only
# then creates worker leaves. DelegateSubgroup= would make /main the namespace
# root too early and hide the unit root, so it must remain unset. The installer
# rejects kernels before 5.7, systemd before 257, hybrid/v1 cgroups, and a missing
# cgroup-v2
# memory or pids controller before it publishes anything.
# The runtime admits at most two workers and gives each leaf memory.max=512MiB,
# memory.swap.max=0, memory.oom.group=1, and pids.max=32.
# Inside the private namespace the delegated unit root stays /sys/fs/cgroup.
# The process starts at 0::/ and reports 0::/main after trusted normalization.
MemoryAccounting=yes
TasksAccounting=yes
Delegate=memory pids

LimitNOFILE=65535

# Sandbox. This process binds :853 for DoT and the operator's gateway ports,
# which is the whole reason it needs a capability at all. AF_NETLINK is
# REQUIRED and not decorative: the UDP/QUIC DIRECT dial path does a route-table
# lookup (route ip+net: netlinkrib) that fatals the forward with "address
# family not supported by protocol" without it, confirmed on test-env
# 2026-07-14. TCP is unaffected, so the failure presents as "QUIC is broken"
# rather than as a sandbox problem.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=private
RestrictSUIDSGID=yes
# Do not add RestrictNamespaces=. systemd 257 implements any value of that
# directive by returning ENOSYS for every clone3 call because seccomp cannot
# inspect clone3's pointed-to flag structure. Go's UseCgroupFD requires
# clone3(CLONE_INTO_CGROUP) to start a worker directly in its sealed leaf.
# Direct namespace switching remains denied. The mandatory runtime startup probe
# proves the required clone3 path before any gateway listener opens; probe
# failure terminates monolith startup, while later child failures remain local.
SystemCallFilter=~unshare setns
LockPersonality=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX

# mihomo's safe-path check only trusts files under -d plus SAFE_PATHS. The DoT
# leaf, the shared controller certificate, the interception leaf and the
# zashboard bundle all live outside /etc/5gpn/mihomo, so they are named here
# rather than by relaxing the check.
Environment=SAFE_PATHS=/etc/5gpn/cert/console:/etc/5gpn/cert/dot:/etc/5gpn/intercept/tls:/opt/5gpn/ui

# Writable: mihomo's own directory, which now also holds the 5gpn/ state
# documents, and the per-extension persistent storage.
ReadWritePaths=/etc/5gpn/mihomo /var/lib/5gpn-intercept

# Readable: the certificates it serves and verifies against, and the UI bundle
# it serves at /ui/ — all read-only. Nothing in this process is entitled to
# replace a certificate: issuing belongs to the root oneshots, and a
# network-facing process able to rewrite its own leaf could rewrite the SAN set
# that bounds what it may intercept. The bundle is read-only for the plainer
# reason that a process serving static assets has no business rewriting them.
ReadOnlyPaths=/etc/5gpn/cert /etc/5gpn/intercept/tls /opt/5gpn/ui

# The CA signing key is the one secret this process must never hold. It can mint
# a leaf for any name, so an engine compromise that reached it would be a
# compromise of every TLS identity this gateway can present — permanently, and
# far beyond the SAN set the published leaf bounds it to. ACME credentials are
# unrelated to the data plane and are excluded for the same reason.
InaccessiblePaths=-/etc/5gpn/intercept-ca -/etc/5gpn/acme -/etc/5gpn/dns.env

[Install]
WantedBy=multi-user.target
