# 5gpn-unit-id: mihomo.service:v3
[Unit]
Description=5gpn (DNS engine, interception engine, forwarding data plane, control API)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10
StartLimitAction=none

[Service]
Type=simple
ExecStart=/opt/5gpn/bin/mihomo -f /etc/5gpn/mihomo/config.yaml -d /etc/5gpn/mihomo
# mihomo is the complete gateway runtime. Any unexpected exit, including a
# clean return after a fatal listener ends, must replace the whole process from
# its atomically persisted state. A deliberate `systemctl stop` is not restarted
# by systemd even with Restart=always.
Restart=always
RestartSec=3
User=mihomo
Group=mihomo
UMask=0027

# One process now, so this unit carries the union of what three used to. What
# it does not carry is the coordination between them: the overlay control and
# generation sockets are gone, and with them the runtime directory that held
# them and the two groups whose only purpose was handing a socket from one
# service user to another. There is no second process left to agree with.

# The interception leaf is published by the root oneshot that owns the CA, and
# this group is how it is read. Membership grants nothing else — the group owns
# the leaf and nothing besides.
SupplementaryGroups=gpn-intercept

LimitNOFILE=65535

# Sandbox. This process binds :853 for DoT and the operator's gateway ports,
# which is the whole reason it needs a capability at all. AF_NETLINK is
# REQUIRED and not decorative: the UDP/QUIC DIRECT dial path does a route-table
# lookup (route ip+net: netlinkrib) that fatals the forward with "address
# family not supported by protocol" without it, confirmed on test-env
# 2026-07-14. TCP is unaffected, so the failure presents as "QUIC is broken"
# rather than as a sandbox problem.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX

# mihomo's safe-path check only trusts files under -d plus SAFE_PATHS. The DoT
# leaf, the shared controller certificate, the interception leaf and the
# zashboard bundle all live outside /etc/5gpn/mihomo, so they are named here
# rather than by relaxing the check.
Environment=SAFE_PATHS=/etc/5gpn/cert/console:/etc/5gpn/cert/dot:/etc/5gpn/intercept/tls:/opt/5gpn/ui

# Writable: mihomo's own directory, which now also holds the gpn/ state
# documents, and the per-extension persistent storage.
ReadWritePaths=/etc/5gpn/mihomo /var/lib/5gpn-intercept

# Readable: the certificates it serves and verifies against, and the UI bundle
# it serves at /ui/ — all read-only. Nothing in this process is entitled to
# replace a certificate: issuing belongs to the root oneshots, and a
# network-facing process able to rewrite its own leaf could rewrite the SAN set
# that bounds what it may intercept. The bundle is read-only for the plainer
# reason that a process serving static assets has no business rewriting them.
ReadOnlyPaths=/etc/5gpn/cert /etc/5gpn/intercept/tls /opt/5gpn/ui

# The CA signing key is the one secret this process must never hold. It can mint
# a leaf for any name, so an engine compromise that reached it would be a
# compromise of every TLS identity this gateway can present — permanently, and
# far beyond the SAN set the published leaf bounds it to. ACME credentials are
# unrelated to the data plane and are excluded for the same reason.
InaccessiblePaths=-/etc/5gpn/intercept-ca -/etc/5gpn/acme -/etc/5gpn/dns.env

[Install]
WantedBy=multi-user.target
