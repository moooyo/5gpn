# 5gpn-unit-id: 5gpn-intercept-cert.service:v2
[Unit]
Description=Publish the fenced 5gpn interception certificate result
After=local-fs.target
# The helper internally converges across a bounded burst of request attempts.
# Keep coalesced PathChanged recovery inside systemd's guard without inheriting
# the default five-start burst.
StartLimitIntervalSec=30
StartLimitBurst=64

[Service]
Type=oneshot
ExecStart=/opt/5gpn/scripts/intercept-cert-renew.sh
User=root
Group=root
SupplementaryGroups=fivegpn
UMask=0077
RuntimeDirectory=5gpn
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/etc/5gpn/intercept /run/5gpn
ReadOnlyPaths=/etc/5gpn/intercept-ca /etc/5gpn/mihomo/5gpn /opt/5gpn/scripts/intercept-cert-renew.sh
