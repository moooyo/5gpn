# 5gpn-unit-id: 5gpn-intercept-cert.path:v1
[Unit]
Description=Watch the engine's certificate request

[Path]
# The request, not the document. The document changes whenever an operator
# edits a setting or a binding; the request changes only when the set of
# hosts the leaf must cover does, so this fires when a reissue is actually
# needed rather than on every unrelated edit.
PathChanged=/etc/5gpn/mihomo/gpn/certificate-request
Unit=5gpn-intercept-cert.service

[Install]
WantedBy=multi-user.target
