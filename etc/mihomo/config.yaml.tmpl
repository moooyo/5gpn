# 5gpn mihomo data plane — install-time seed (rendered by install.sh). This
# file is fully operator-owned from here on: no region of it is daemon-
# managed by the daemon -- edit it via the
# console's mihomo config editor (GET/PUT /api/mihomo/config), '5gpn
# mihomo-reset' to restore this seed, or by hand. The console's policy
# engine only ever decides "gateway or not" (DNS layer); everything below
# about what happens to gateway-bound traffic is yours to shape.
external-controller: ""
# Loopback, on :443, because that is the port a browser reaching
# https://__CONSOLE_DOMAIN__/ arrives on. The console name resolves to 127.0.0.1
# through the hosts block below, so the allow rule's DIRECT dial lands here --
# on this same process, through a different listener, with no second origin and
# no proxy in front. Moving this port breaks that path silently: the rule still
# matches, the dial still succeeds against nothing, and the panel just does not
# answer.
external-controller-tls: 127.0.0.1:443
# The zashboard bundle, served at /ui/ on the controller above -- so the panel
# is https://__CONSOLE_DOMAIN__/ui/. This path is not
# free: mihomo.service names it in both SAFE_PATHS and ReadOnlyPaths, and the
# unit's ReadOnlyPaths entry carries no `-` prefix, so systemd refuses to build
# the namespace -- the service does not start -- if nothing has published here.
# install.sh publishes the dist to it before install_units runs.
external-ui: /opt/5gpn/ui
secret: '__CONTROLLER_SECRET__'
tls:
  certificate: /etc/5gpn/cert/console/current/fullchain.pem
  private-key: /etc/5gpn/cert/console/current/privkey.pem
profile: { store-selected: true }
mode: rule
log-level: info
# 5gpn is an IPv4-only steering gateway. mihomo defaults this to TRUE, which
# makes it resolve AAAA and race an IPv6 egress it cannot fall back from once
# the TCP dial succeeds. The resolver also answers AAAA with NODATA on the
# 127.0.0.1:5354 origin resolver below, so this line is belt-and-braces for the
# paths that do not go through it (e.g. a proxy node named by hostname).
ipv6: false

listeners:
__MIHOMO_LISTENERS__

sniffer:
  enable: true
  parse-pure-ip: true
  override-destination: true
  force-domain: [__CONSOLE_DOMAIN__]
  sniff:
    TLS:  { ports: [443, 8080, 8443, 5060] }
    QUIC: { ports: [443, 5060] }
    HTTP: { ports: [80, 8080, 8443, 5060] }

dns:
  enable: true
  enhanced-mode: normal
  nameserver: ["udp://127.0.0.1:5354"]   # loopback origin resolver: extension China/trust binding, otherwise trust

hosts:
  __CONSOLE_DOMAIN__: 127.0.0.1

# Egress skeleton -- empty by default. Add proxy nodes (proxies:) and/or
# node-subscription providers (proxy-providers:), then wire them into
# proxy-groups as you like; the terminal MATCH rule below routes every
# gateway-bound query that reached this point to the Proxies group.
#
# There is no interception outbound to declare here. Capture is a stage inside
# this process -- the core hands a sniffed connection to the engine before
# anything is read off it -- so there is no second program to reach over a
# loopback proxy and nothing for the operator to keep wired.
proxies: []
proxy-providers: {}

proxy-groups:
  - {name: Proxies, type: select, proxies: [DIRECT]}

rules:
  - AND,((DOMAIN,__CONSOLE_DOMAIN__),(NETWORK,UDP)),REJECT
  - AND,((DOMAIN,__CONSOLE_DOMAIN__),(DST-PORT,80)),REJECT
  - AND,((DOMAIN,__CONSOLE_DOMAIN__),(DST-PORT,8080)),REJECT
  - AND,((DOMAIN,__CONSOLE_DOMAIN__),(DST-PORT,8443)),REJECT
  - AND,((DOMAIN,__CONSOLE_DOMAIN__),(DST-PORT,5060)),REJECT
  # The one panel allow rule. It carries two predicates and both are load-bearing.
  #
  # NOT,((IN-TYPE,INNER)) excludes the engine's own egress. The engine has no
  # socket of its own: every upstream it opens -- a captured connection's own
  # upstream, or a network.request from a plugin script -- goes back through
  # this same rule set by inner dialing and arrives as INNER. That is what keeps
  # intercepted traffic inside the operator's routing, and it is also what these
  # rules have to tell engine egress apart from. Without the exclusion a
  # captured extension naming the console reaches the management plane.
  #
  # It must sit above the loopback deny, because the console resolves to
  # 127.0.0.1, and therefore above everything below it.
  #
  # There is no source restriction. The panel and the control API answer any
  # client that can reach this gateway on :443 and resolve the console name;
  # /api/* still requires the bearer token, and /ui/ deliberately does not,
  # because an unenrolled phone fetching its profile holds no token.
  - AND,((NOT,((IN-TYPE,INNER))),(DOMAIN,__CONSOLE_DOMAIN__)),DIRECT
  # Fail closed for what the rule above excluded. A captured extension dialling
  # the console arrives as INNER, misses that rule, and stops here rather than
  # falling through to the loopback deny -- which is the right answer for the
  # wrong reason, and would stop being right the moment the console stopped
  # resolving to 127.0.0.1.
  - DOMAIN,__CONSOLE_DOMAIN__,REJECT
  - IP-CIDR,__GATEWAY_IP__/32,REJECT,no-resolve
  - IP-CIDR,127.0.0.0/8,REJECT,no-resolve
  - IP-CIDR,10.0.0.0/8,REJECT,no-resolve
  - IP-CIDR,172.16.0.0/12,REJECT,no-resolve
  - IP-CIDR,192.168.0.0/16,REJECT,no-resolve
  - IP-CIDR,100.64.0.0/10,REJECT,no-resolve
  - IP-CIDR,169.254.0.0/16,REJECT,no-resolve
  # The backstop behind datagram capture. Capture is consulted before rule
  # resolution, so with mitm.http3 on this reject only ever sees the datagrams
  # capture did not want, and with it off it is the whole mechanism -- a capable
  # client falls back to TCP, which is captured. Removing it does not enable
  # QUIC capture; it makes gateway QUIC bypass interception whenever http3 is
  # off or the master switch is.
  - AND,((NETWORK,UDP),(DST-PORT,443)),REJECT
  - MATCH,Proxies
