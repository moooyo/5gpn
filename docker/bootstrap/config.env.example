# Copy this file to docker/bootstrap/config.env before starting Compose.
# Values are parsed as literal text: do not add shell quotes or `export`.

# One lowercase apex domain. Docker always uses Cloudflare DNS-01 and derives
# console.<base> plus dot.<base> from this value.
DNS_BASE_DOMAIN=example.com

# IPv4 returned to clients for gateway-steered answers.
DNS_GATEWAY_IP=203.0.113.10

# Optional public DNS identity. Defaults to DNS_GATEWAY_IP when omitted.
# DNS_PUBLIC_IP=203.0.113.10

# Container data-plane listeners are fixed at 0.0.0.0. Compose publishes the
# supported host ports from its bridge; there is no Docker listener-IP setting.

# Let's Encrypt account address. Docker supports Cloudflare only.
CERT_EMAIL=operator@example.com
CERT_MODE=cloudflare
