# Copy this file to docker/bootstrap/config.env before starting Compose.
# Values are parsed as literal text: do not add shell quotes or `export`.

# One lowercase apex domain. Docker derives console.<base> and dot.<base> from
# this value. See CERT_MODE below for how the certificate for it is obtained.
DNS_BASE_DOMAIN=example.com

# IPv4 returned to clients for gateway-steered answers.
DNS_GATEWAY_IP=203.0.113.10

# Optional public DNS identity. Defaults to DNS_GATEWAY_IP when omitted.
# DNS_PUBLIC_IP=203.0.113.10

# Container data-plane listeners are fixed at 0.0.0.0. Compose publishes the
# supported host ports from its bridge; there is no Docker listener-IP setting.

# Let's Encrypt account address.
CERT_EMAIL=operator@example.com

# cloudflare issues a real Let's Encrypt DNS-01 wildcard and requires the
# Cloudflare API token secret. It is the only mode a release-mode acceptance run
# may use.
#
# debug issues a self-signed wildcard locally instead: no token, no network, no
# Let's Encrypt order. Clients do not trust it, so it is for testing only -- but
# it makes UI generation, certificate-role publication, and the running gateway
# reachable without a real domain. A volume bootstrapped in debug commits a
# distinct lineage marker and can never satisfy release acceptance.
CERT_MODE=cloudflare
